# Working/draft files
R/utils/table_utils working.R
R/modules/state/state_manager_working.R
R/utils/broken_table_utils.R

# Development environment
.Rproj.user
.bold_api_key
.RData
.Rhistory

# Database files (created at runtime)
/data/sessions.sqlite
/data/sessions.sqlite-wal
/data/sessions.sqlite-shm
/data/specimen_tracking.db
/data/sessions

# Runtime output directories
/logs/
/output/
/temp/

# renv library (packages restored per-machine, not committed)
renv/library/
renv/staging/
renv/sandbox/
renv/cellar/
renv/local/
renv/lock/
renv/python/

# Local secrets and environment files -- never commit these
.env
.env.*
*.pem
*.p12
*.key

# Python caches and build outputs (python/.gitignore has the app's own)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Files the security/release workflows write into the checkout
python/requirements-release.txt
python/audit-*.txt
*.sarif
