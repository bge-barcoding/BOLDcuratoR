# Fixtures and exports are large build outputs, never committed.
# Putting a 400 MB file in git would be the same mistake as putting the snapshot
# in GitLab: git keeps every version forever.
fixtures/
app/fixtures/
site/
*.duckdb
*.duckdb.wal
*.data
*.js.metadata

# The --out directory the README suggests for real-BOLD fixtures.
fixtures-real/
